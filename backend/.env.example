JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development
PORT=8000
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require

# Admin panel secret key required for /api/admin/* and /admin-panel
# If unset or empty, all admin routes return 404 (disabled)
ADMIN_SECRET_KEY=

# Reverse proxy trusted count for client IP extraction in rate limiting
# Default 0 (uses request.client.host, ignores X-Forwarded-For)
# Set to 1 if behind 1 reverse proxy (e.g. Nginx, Cloudflare, AWS ALB), counting from the right
TRUSTED_PROXY_COUNT=0

# Admin session cookie Secure flag: auto (default), true, false
# auto: Secure is enabled when HTTPS is detected or X-Forwarded-Proto: https with TRUSTED_PROXY_COUNT > 0
# true: Forces Secure=True (requires HTTPS in production)
# false: Disables Secure=True (local dev over HTTP)
ADMIN_COOKIE_SECURE=auto
